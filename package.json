{
  "name": "hybrid-launcher",
  "productName": "Hybrid Launcher",
  "version": "1.0.2",
  "description": "One launcher for all your games — Steam, Epic, and anything else on your PC.",
  "main": "src/main.js",
  "author": "nashpotaters12312",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.nashpotaters.hybridlauncher",
    "productName": "Hybrid Launcher",
    "files": [
      "src/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hybrid Launcher",
      "artifactName": "Hybrid-Launcher-Setup-${version}.exe"
    }
  },
  "overrides": {
    "@electron/universal": {
      "minimatch": "^11.0.4"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.4"
    }
  }
}
